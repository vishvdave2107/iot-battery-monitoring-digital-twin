[
  {
    "id": "tab_battery_demo",
    "type": "tab",
    "label": "EV Battery Dashboard",
    "disabled": false,
    "info": "Simulated battery readings for dashboard testing."
  },
  {
    "id": "inject_battery_demo",
    "type": "inject",
    "z": "tab_battery_demo",
    "name": "Generate sample readings",
    "props": [
      {
        "p": "payload"
      },
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "battery",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 160,
    "wires": [
      [
        "function_battery_demo"
      ]
    ]
  },
  {
    "id": "function_battery_demo",
    "type": "function",
    "z": "tab_battery_demo",
    "name": "Create simulated battery data",
    "func": "const voltage = +(48 + Math.random() * 2).toFixed(2);\nconst current = +(2 + Math.random() * 4).toFixed(2);\nconst power = +(voltage * current).toFixed(1);\nconst temperature = +(25 + Math.random() * 8).toFixed(1);\nconst soc = +(55 + Math.random() * 10).toFixed(0);\nconst alarm = temperature > 32 ? \"WARNING: HIGH TEMPERATURE\" : \"Normal\";\nreturn [\n  {payload: voltage + \" V\", topic: \"Voltage\"},\n  {payload: current + \" A\", topic: \"Current\"},\n  {payload: power + \" W\", topic: \"Power\"},\n  {payload: temperature + \" \u00b0C\", topic: \"Temperature\"},\n  {payload: soc + \" %\", topic: \"State of Charge\"},\n  {payload: alarm, topic: \"Alarm Status\"},\n  {payload: voltage, topic: \"Voltage (V)\"}\n];",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 160,
    "wires": [
      [
        "ui_text_voltage"
      ],
      [
        "ui_text_current"
      ],
      [
        "ui_text_power"
      ],
      [
        "ui_text_temperature"
      ],
      [
        "ui_text_soc"
      ],
      [
        "ui_text_alarm"
      ],
      [
        "ui_chart_voltage"
      ]
    ]
  },
